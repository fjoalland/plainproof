# Copy to .env (never commit it). plainproof reads it from the current folder or its parents.

# The key of the model provider you use (see `plainproof providers`):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# OPENROUTER_API_KEY=

# Optional defaults (command-line options win):
# PLAINPROOF_MODEL=anthropic:claude-sonnet-5-5
# PLAINPROOF_LANGUAGE=en

# The test account referred to by your context.md. A variable whose name contains PASSWORD, PASS,
# PWD, SECRET, TOKEN or KEY is never shown to the model nor written in a report.
# APP_USER=
# APP_PASSWORD=

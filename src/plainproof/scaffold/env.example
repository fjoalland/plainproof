# Copy to .env (never commit it). plainproof reads it from the current folder or its parents.

# One key for the model provider you use (see `plainproof providers`):
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=

# The test account used by context.md. A variable whose name contains PASSWORD, PASS, PWD,
# SECRET, TOKEN or KEY is never shown to the model nor written in a report.
APP_USER=
APP_PASSWORD=
